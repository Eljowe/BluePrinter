{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install WebUI dependencies",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "if (Test-Path WebUI\\node_modules) { Write-Host 'WebUI\\node_modules already present, skipping install.' } else { Push-Location WebUI; npm install; Pop-Location }"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Build WebUI",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Push-Location WebUI; npm run build; Pop-Location"
      ],
      "isBackground": false,
      "problemMatcher": [],
      "dependsOn": "Install WebUI dependencies"
    },
    {
      "label": "Build BluePrinter Debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--config", "Debug"],
      "isBackground": false,
      "problemMatcher": ["$msCompile"],
      "group": "build",
      "dependsOn": "Build WebUI"
    },
    {
      "label": "Rebuild BluePrinter Debug",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-Command", "cmake --build build --config Debug --clean-first"],
      "isBackground": false,
      "problemMatcher": ["$msCompile"],
      "group": "build",
      "dependsOn": "Build WebUI"
    },
    {
      "label": "Run BluePrinter Debug",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "cmake --build build --config Debug --target BluePrinter_Standalone; Start-Process -FilePath \".\\build\\BluePrinter_artefacts\\Debug\\Standalone\\BluePrinter.exe\""
      ],
      "isBackground": false,
      "problemMatcher": ["$msCompile"],
      "group": "test",
      "dependsOn": "Build WebUI"
    },
    {
      "label": "Run BluePrinter Release (standalone only)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-Process -Name BluePrinter -ErrorAction SilentlyContinue | Stop-Process -Force; cmake --build build --config Release --target BluePrinter_Standalone; Start-Process -FilePath \".\\build\\BluePrinter_artefacts\\Release\\Standalone\\BluePrinter.exe\""
      ],
      "isBackground": false,
      "problemMatcher": ["$msCompile"],
      "group": "test",
      "dependsOn": "Build WebUI"
    },
    {
      "label": "Build + Install + Run BluePrinter (Release, per-user)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-Process -Name BluePrinter -ErrorAction SilentlyContinue | Stop-Process -Force; $env:BLUEPRINTER_HOME = Join-Path $env:USERPROFILE 'BluePrinter'; if (-not (Test-Path build -PathType Container)) { cmake -S . -B build \"-DBLUEPRINTER_VST3_DIR=$(Join-Path $env:BLUEPRINTER_HOME 'VST3')\" | Out-Null }; cmake --build build --config Release --target BluePrinter_Standalone BluePrinter_VST3; cmake --install build --config Release --prefix $env:BLUEPRINTER_HOME; Start-Process -FilePath (Join-Path $env:BLUEPRINTER_HOME 'BluePrinter.exe')"
      ],
      "isBackground": false,
      "problemMatcher": ["$msCompile"],
      "group": "test",
      "dependsOn": "Build WebUI"
    },
    {
      "label": "Install VST3 to Program Files (elevated)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\cmake\\build-install-vst3.ps1"
      ],
      "isBackground": false,
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Build Installer (Inno Setup)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "cmake --build build --config Release --target BluePrinter_Standalone BluePrinter_VST3; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; & (Join-Path $env:LOCALAPPDATA 'Programs\\Inno Setup 6\\ISCC.exe') installer\\BluePrinter.iss"
      ],
      "isBackground": false,
      "problemMatcher": [],
      "group": "build",
      "dependsOn": "Build WebUI"
    },
    {
      "label": "Build Release Bundle (installer + checksums)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\installer\\build-release.ps1"
      ],
      "isBackground": false,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Create GitHub Release (draft)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\installer\\create-release.ps1"
      ],
      "isBackground": false,
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
